# URJA-SETU backend — copy to .env (run from this directory)
APP_NAME=URJA-SETU
VERSION=0.1.0
# demo | live  (demo = seeded deterministic story; live = real feeds)
MODE=demo

# --- Free LLM (Groq primary, Gemini fallback, Ollama local fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Data stores ---
DATABASE_URL=postgresql://urja:urja@localhost:5432/urja
REDIS_URL=redis://localhost:6379/0

# --- Data feeds (used from Sprint 1/2) ---
GDELT_ENABLED=false
AISSTREAM_API_KEY=
